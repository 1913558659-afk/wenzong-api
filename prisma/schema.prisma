generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  nickname     String?
  role         String   @default("student")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stats              UserStats?
  answerAttempts     AnswerAttempt[]
  completedQuestions CompletedQuestion[]
  wrongQuestions     WrongQuestion[]

  @@map("users")
}

model UserStats {
  id            String    @id @default(uuid())
  userId        String    @unique
  xp            Int       @default(0)
  streakDays    Int       @default(0)
  answeredToday Int       @default(0)
  correctCount  Int       @default(0)
  totalAnswered Int       @default(0)
  lastStudyDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model AnswerAttempt {
  id             String   @id @default(uuid())
  userId         String
  questionId     String
  subject        String
  chapter        String
  selectedAnswer String
  correctAnswer  String
  isCorrect      Boolean
  answeredAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questionId])
  @@map("answer_attempts")
}

model CompletedQuestion {
  id          String   @id @default(uuid())
  userId      String
  questionId  String
  subject     String
  chapter     String
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@map("completed_questions")
}

model WrongQuestion {
  id             String   @id @default(uuid())
  userId         String
  questionId     String
  subject        String
  chapter        String
  selectedAnswer String
  correctAnswer  String
  wrongCount     Int      @default(1)
  isResolved     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@map("wrong_questions")
}

model Subject {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapters  Chapter[]
  questions Question[]

  @@map("subjects")
}

model Chapter {
  id         String   @id @default(uuid())
  subjectId  String
  title      String
  code       String?
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([subjectId])
  @@map("chapters")
}

model Question {
  id            String   @id @default(uuid())
  subjectId     String
  chapterId     String?
  questionCode  String   @unique
  stem          String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  explanation   String?
  difficulty    String?
  tags          Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapter Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@index([subjectId])
  @@index([chapterId])
  @@index([isActive])
  @@map("questions")
}
